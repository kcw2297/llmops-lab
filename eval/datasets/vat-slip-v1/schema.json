{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vat_slip",
  "description": "부가가치세 납부서에서 읽은 값. 문서에 없는 값은 null. 계산하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxpayer_name",
    "business_reg_no",
    "tax_item",
    "tax_period_start",
    "tax_period_end",
    "due_date",
    "total_amount",
    "electronic_payment_no",
    "virtual_account_no",
    "tax_office"
  ],
  "properties": {
    "taxpayer_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "납부자 상호",
      "x-ocr-type": "text"
    },
    "business_reg_no": {
      "type": [
        "string",
        "null"
      ],
      "description": "사업자등록번호(문서 표기 그대로)",
      "x-ocr-type": "id"
    },
    "tax_item": {
      "type": [
        "string",
        "null"
      ],
      "description": "세목",
      "x-ocr-type": "text"
    },
    "tax_period_start": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "과세기간 시작일 YYYY-MM-DD",
      "x-ocr-type": "date"
    },
    "tax_period_end": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "과세기간 종료일 YYYY-MM-DD",
      "x-ocr-type": "date"
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "납부기한 YYYY-MM-DD",
      "x-ocr-type": "date"
    },
    "total_amount": {
      "type": [
        "integer",
        "null"
      ],
      "description": "납부할 세액 합계(원, 정수)",
      "x-ocr-type": "amount"
    },
    "electronic_payment_no": {
      "type": [
        "string",
        "null"
      ],
      "description": "전자납부번호(문서 표기 그대로)",
      "x-ocr-type": "id"
    },
    "virtual_account_no": {
      "type": [
        "string",
        "null"
      ],
      "description": "납부 가상계좌 번호(문서 표기 그대로)",
      "x-ocr-type": "id"
    },
    "tax_office": {
      "type": [
        "string",
        "null"
      ],
      "description": "관할 세무서명",
      "x-ocr-type": "text"
    }
  }
}
